{

    type Option = forall a . super::option::Option a,

    #############################################
    ### High-frequency, low-level operations - direct builtins
    #############################################

    length : forall a . List a -> Num = list_length,
    is_empty : forall a . List a -> Bool = list_is_empty,
    reverse : forall a . List a -> List a = list_reverse,
    sum : List Num -> Num = list_sum,
    first : forall a . List a -> Option a = list_first,
    last : forall a . List a -> Option a = list_last,

    #############################################
    ### High-frequency, low-level operations - wrapped builtins
    #############################################

    prepend : forall a . a -> List a -> List a = fn head =>
        fn tail_list => (list_prepend { head = head, tail = tail_list }),

    append : forall a . List a -> a -> List a = fn head_list =>
        fn tail => (list_append { head = head_list, tail = tail }),

    concat : forall a . List a -> List a -> List a = fn list_a =>
        fn list_b => (list_concat { head = list_a, tail = list_b }),

    contains : forall a . a -> List a -> Bool = fn value =>
        fn list => (list_contains { list = list, value = value }),

    at : forall a . Num -> List a -> Option a = fn index =>
        fn list => (list_at { list = list, index = index }),

    #############################################
    ### Primitive Recursive Functions using list_rec
    #############################################

    map : forall a b . (a -> b) -> List a -> List b = fn f => fn list =>
        (list_rec {
            list = list,
            base = [],
            step = fn pair =>
                let mapped_head = (f pair.head) in
                (prepend mapped_head pair.acc)
        }),

    filter : forall a . (a -> Bool) -> List a -> List a = fn predicate => fn list =>
        (list_rec {
            list = list,
            base = [],
            step = fn pair =>
                if (predicate pair.head)
                then (prepend pair.head pair.acc)
                else pair.acc
        }),

    find : forall a . (a -> Bool) -> List a -> Option a = fn predicate => fn list =>
        (list_rec {
            list = list,
            base = None,
            # TODO investigate why type annotations are necessary here
            step : { acc : Option a, head : a } -> Option a = fn pair =>
                if (predicate pair.head)
                then (Some pair.head)
                else pair.acc
        }),

    fold_left : forall a b . (b -> a -> b) -> b -> List a -> b = fn f => fn init => fn list =>
        (list_rec {
            list = list,
            base = init,
            step = fn pair => (f pair.acc pair.head)
        }),

    fold_right : forall a b . (a -> b -> b) -> b -> List a -> b = fn f => fn init => fn list =>
        (list_rec {
            list = list,
            base = init,
            step = fn pair => (f pair.head pair.acc)
        }),

    all : forall a . (a -> Bool) -> List a -> Bool = fn predicate => fn list =>
        (list_rec {
            list = list,
            base = true,
            step = fn pair =>
                if (predicate pair.head)
                then pair.acc
                else false
        }),

    any : forall a . (a -> Bool) -> List a -> Bool = fn predicate => fn list =>
        (list_rec {
            list = list,
            base = false,
            step = fn pair =>
                if (predicate pair.head)
                then true
                else pair.acc
        }),

    #############################################
    ### Derived Utilities
    #############################################


    flat_map : forall a b . (a -> List b) -> List a -> List b = fn f => fn list =>
        (fold_right
            (fn x => fn acc => (concat (f x) acc))
                [] list)

    # flatten
}
