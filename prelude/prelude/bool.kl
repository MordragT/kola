{
    not : Bool -> Bool = fn b => if b then false else true,

    and : Bool -> Bool -> Bool = fn a => fn b => a && b,

    or : Bool -> Bool -> Bool = fn a => fn b => a || b,

    xor : Bool -> Bool -> Bool = fn a => fn b => (a && !b) || (!a && b),

    eq : Bool -> Bool -> Bool = fn a => fn b => a == b,

    ne : Bool -> Bool -> Bool = fn a => fn b => a != b,

    to_num : Bool -> Num = fn b => if b then 1 else 0,

    to_str : Bool -> Str = fn b => if b then "true" else "false",
}
