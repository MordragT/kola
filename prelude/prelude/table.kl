{
    type Option = forall a . super::option::Option a,

    type Table = forall (r : Row) . List { | r },

    map_rows : forall (r : Row) (s : Row) . ({ | r } -> { | s }) -> Table r -> Table s =
        super::list::map,

    filter_rows : forall (r : Row) . ({ | r } -> Bool) -> Table r -> Table r =
        super::list::filter,

    select_row : forall (r : Row) a . Num -> Table r -> Option { | r } =
        super::list::at,

    prepend_row : forall (r : Row) . { | r } -> Table r -> Table r =
        fn record => fn table =>
            (super::list::prepend record table),

    append_row : forall (r : Row) . Table r -> { | r } -> Table r =
        fn table => fn record =>
            (super::list::append table record),

    select_col : forall (l : Label) (r : Row) a . Label l -> List { @l : a | r } -> List a =
        fn label => fn table =>
            (super::list::map
                (fn record => (super::record::select label record))
                table),

    insert_col : forall (l : Label) (r : Row) a . Label l -> ({ | r } -> a) -> Table r -> List { @l : a | r } =
        fn label => fn f => fn table =>
            (super::list::map
                (fn record => (super::record::insert label (f record) record))
                table),

    remove_col : forall (l : Label) (r : Row) a . Label l -> List { @l : a | r } -> Table r =
        fn label => fn table =>
            (super::list::map
                (fn record => (super::record::remove label record))
                table),

    update_col : forall (l : Label) (r : Row) a b . Label l -> (a -> b) -> List { @l : a | r } -> List { @l : b | r } =
        fn label => fn f => fn table =>
            (super::list::map
                (fn record => (super::record::update label f record))
                table),

    rename_col : forall (l1 : Label) (l2 : Label) (r : Row) a . Label l1 -> Label l2 -> List { @l1 : a | r } -> List { @l2 : a | r } =
        fn label1 => fn label2 => fn table =>
            (super::list::map
                (fn record => (super::record::rename label1 label2 record))
                table),

    # insert_row_at, remove_row_at,

    # Joining two tables on a shared label. Kept disabled until abstract public
    # type members are expressible: this mixin requires a `Row` type component
    # from its provider, and v1 defers the `type T : K` spelling (spec §3.1, §12.2).
    #
    # module type TableShape = {
    #     type Row,
    # },
    #
    # module join = {
    #     module t : TableShape,
    #     join = fn label => fn left : (List t::Row) => fn right : (List t::Row) =>
    #         left |> (super::list::flat_map (fn lrow =>
    #             let lkey = (super::record::select label lrow) in
    #                 right
    #                     |> (super::list::filter (fn rrow =>
    #                         (super::record::select label rrow) == lkey))
    #                     |> (super::list::map (fn rrow =>
    #                         lrow & rrow)))),
    # },
}
