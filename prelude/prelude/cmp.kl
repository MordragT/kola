{
    type Ordering = < Less, Equal, Greater >,

    module type Ord = {
        compare : forall a . a -> a -> Ordering,
    },

    # An open module: `ord` is an abstract submodule until a provider is supplied.
    module max = {
        module ord : Ord,
        max = fn x => fn y =>
            let ordering = (ord::compare x y) in
                case ordering
                    | < Less : _ > => y
                    | < Equal : _ > => x
                    | < Greater : _ > => x,
    },

    module num_ord = {
        compare = fn x => fn y =>
            if x < y then (Less ())
            else if x > y then (Greater ())
            else (Equal ()),
    },

    # `using` matches by key in each namespace, so the provider must expose the
    # required name `ord` in the module namespace; `num_ord` alone is a module
    # named `num_ord` and would supply nothing.
    module num_max = max using { module ord = num_ord },
}
