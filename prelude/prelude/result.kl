{
    type Option = forall a . super::option::Option a,

    type Result = forall a b . < Ok : a, Err : b >,

    #############################################
    ### Core result operations
    #############################################

    is_ok : forall a b . Result a b -> Bool = fn res =>
        case res
        | < Ok : _ > => true
        | < Err : _ > => false,

    is_ok_and : forall a b . (a -> Bool) -> Result a b -> Bool = fn predicate => fn res =>
        case res
        | < Ok : value > => (predicate value)
        | < Err : _ > => false,

    is_err : forall a b . Result a b -> Bool = fn res =>
        case res
        | < Ok : _ > => false
        | < Err : _ > => true,

    is_err_and : forall a b . (b -> Bool) -> Result a b -> Bool = fn predicate => fn res =>
        case res
        | < Ok : _ > => false
        | < Err : err > => (predicate err),

    ok : forall a b . Result a b -> Option a = fn res =>
        case res
        | < Ok : value > => (Some value)
        | < Err : _ > => None,

    err : forall a b . Result a b -> Option b = fn res =>
        case res
        | < Ok : _ > => None
        | < Err : err > => (Some err),

    flatten : forall a b . Result (Result a b) b -> Result a b = fn res =>
        case res
        | < Ok : inner > => inner
        | < Err : err > => (Err err),

    map : forall a b c . (a -> c) -> Result a b -> Result c b = fn f => fn res =>
        case res
        | < Ok : value > => (Ok (f value))
        | < Err : err > => (Err err),

    map_err : forall a b c . (b -> c) -> Result a b -> Result a c = fn f => fn res =>
        case res
        | < Ok : value > => (Ok value)
        | < Err : err > => (Err (f err)),

    map_or : forall a b c . c -> (a -> c) -> Result a b -> c = fn default => fn f => fn res =>
        case res
        | < Ok : value > => (f value)
        | < Err : _ > => default,

    map_or_else : forall a b c . (b -> c) -> (a -> c) -> Result a b -> c = fn err_f => fn ok_f => fn res =>
        case res
        | < Ok : value > => (ok_f value)
        | < Err : err > => (err_f err),

    and : forall a b c . Result a b -> Result c b -> Result c b = fn res => fn next =>
        case res
        | < Ok : _ > => next
        | < Err : err > => (Err err),

    and_then : forall a b c . (a -> Result c b) -> Result a b -> Result c b = fn f => fn res =>
        case res
        | < Ok : value > => (f value)
        | < Err : err > => (Err err),

    or : forall a b c . Result a b -> Result a c -> Result a c = fn res => fn alt =>
        case res
        | < Ok : value > => (Ok value)
        | < Err : _ > => alt,

    or_else : forall a b c . (b -> Result a c) -> Result a b -> Result a c = fn f => fn res =>
        case res
        | < Ok : value > => (Ok value)
        | < Err : err > => (f err),

    get_or : forall a b . a -> Result a b -> a = fn default => fn res =>
        case res
        | < Ok : value > => value
        | < Err : _ > => default,

    get_or_else : forall a b . (b -> a) -> Result a b -> a = fn f => fn res =>
        case res
        | < Ok : value > => value
        | < Err : err > => (f err),

    get_err_or : forall a b . b -> Result a b -> b = fn default => fn res =>
        case res
        | < Ok : _ > => default
        | < Err : err > => err,

    get_err_or_else : forall a b . (a -> b) -> Result a b -> b = fn f => fn res =>
        case res
        | < Ok : value > => (f value)
        | < Err : err > => err,

    contains : forall a b . a -> Result a b -> Bool = fn target => fn res =>
        case res
        | < Ok : value > => value == target
        | < Err : _ > => false,

    contains_err : forall a b . b -> Result a b -> Bool = fn target => fn res =>
        case res
        | < Ok : _ > => false
        | < Err : err > => err == target,
}
