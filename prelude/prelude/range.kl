{
    type Option = forall a . super::option::Option a,

    # A half-open range type bounded inclusive at the start and exclusive at the end.
    # TODO for now this is number (f64) based, but for correctness these should be integral
    type Range = { start : Num, end : Num },

    # Half-open: start...end
    range : Num -> Num -> Range = fn start => fn end =>
        { start = start, end = end },

    # Inclusive range: start...=end
    range_inclusive : Num -> Num -> Range = fn start => fn end =>
        { start = start, end = end + 1 },

    contains : Range -> Num -> Bool = fn r => fn n =>
        n >= r.start && n < r.end,

    length : Range -> Num = fn r =>
        r.end - r.start,

    is_empty : Range -> Bool = fn r =>
        r.start >= r.end,

    fold : forall a . (a -> Num -> a) -> a -> Range -> a = fn f => fn init => fn r =>
        (num_rec {
            num = r.end - r.start,
            base = init,
            step = fn pair => (f pair.acc (pair.head + r.start))
        }),

    map : forall a . (Num -> a) -> Range -> List a = fn f => fn r =>
        (num_rec {
            num = r.end - r.start,
            base = [],
            step = fn pair => (super::list::prepend (f (pair.head + r.start)) pair.acc)
        }),

    filter : (Num -> Bool) -> Range -> List Num = fn predicate => fn r =>
        (num_rec {
            num = r.end - r.start,
            base = [],
            step = fn pair =>
                if (predicate (pair.head + r.start))
                then (super::list::prepend (pair.head + r.start) pair.acc)
                else pair.acc
        }),

    sum : Range -> Num = fn r =>
        (num_rec {
            num = r.end - r.start,
            base = 0,
            step = fn pair => (pair.acc + (pair.head + r.start))
        }),

    to_list : Range -> List Num = fn r =>
        (num_rec {
            num = r.end - r.start,
            base = [],
            step = fn pair => (super::list::prepend (pair.head + r.start) pair.acc)
        }),


