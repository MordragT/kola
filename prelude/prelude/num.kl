{

    #############################################
    ### Named operator functions (for composition)
    #############################################

    # Arithmetic
    add : Num -> Num -> Num = fn a => fn b => a + b,
    sub : Num -> Num -> Num = fn a => fn b => a - b,
    mul : Num -> Num -> Num = fn a => fn b => a * b,
    div : Num -> Num -> Num = fn a => fn b => a / b,
    rem : Num -> Num -> Num = fn a => fn b => a % b,

    # Comparison
    eq : Num -> Num -> Bool = fn a => fn b => a == b,
    ne : Num -> Num -> Bool = fn a => fn b => a != b,
    lt : Num -> Num -> Bool = fn a => fn b => a < b,
    le : Num -> Num -> Bool = fn a => fn b => a <= b,
    gt : Num -> Num -> Bool = fn a => fn b => a > b,
    ge : Num -> Num -> Bool = fn a => fn b => a >= b,

    #############################################
    ### Advanced math functions (builtins)
    #############################################

    abs : Num -> Num = num_abs,
    sqrt : Num -> Num = num_sqrt,
    floor : Num -> Num = num_floor,
    ceil : Num -> Num = num_ceil,
    round : Num -> Num = num_round,

    sin : Num -> Num = num_sin,
    cos : Num -> Num = num_cos,
    tan : Num -> Num = num_tan,

    ln : Num -> Num = num_ln,
    log10 : Num -> Num = num_log10,
    exp : Num -> Num = num_exp,

    pow : Num -> Num -> Num = fn base => fn exp =>
        (num_pow { base = base, exp = exp }),

    #############################################
    ### Utility functions
    #############################################

    max : Num -> Num -> Num = fn a => fn b =>
        if a > b then a else b,

    min : Num -> Num -> Num = fn a => fn b =>
        if a < b then a else b,

    clamp : Num -> Num -> Num -> Num = fn min_val => fn max_val => fn value =>
        if value < min_val then min_val
        else if value > max_val then max_val
        else value,

    sign : Num -> Num = fn n =>
        if n == 0 then 0
        else if n > 0 then 1
        else -1,

    is_even : Num -> Bool = fn n => n % 2 == 0,
    is_odd : Num -> Bool = fn n => n % 2 != 0,

    square : Num -> Num = fn n => n * n,
    cube : Num -> Num = fn n => n * n * n,
}
